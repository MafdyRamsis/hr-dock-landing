# Server-only credentials used by /api/demo-request. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_with_resend_api_key
DEMO_FROM_EMAIL=HR Dock <demo@hr-dock.com>
DEMO_TO_EMAIL=replace_with_monitored_inbox

# Website admin at /admin. Use long, unique values in production.
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters

# Created automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
